DATABASE_URL="postgresql://postgres:ПАРОЛЬ@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=8h
PORT=4000
NODE_ENV=production

# WebAuthn / Face ID configuration
# RP_ID must match the domain the frontend is served from (without port for localhost)
WEBAUTHN_RP_NAME=StockOS
WEBAUTHN_RP_ID=smart-inventory-khaki.vercel.app
WEBAUTHN_ORIGIN=smart-inventory-khaki.vercel.app
# For production: WEBAUTHN_RP_ID=yourdomain.com, WEBAUTHN_ORIGIN=https://yourdomain.com

FRONTEND_URL=http://localhost:3000
