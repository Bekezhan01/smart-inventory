DATABASE_URL="postgresql://inventory_user:inventory_pass@localhost:5432/inventory_db"
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=8h
PORT=4000
NODE_ENV=development

# WebAuthn / Face ID configuration
# RP_ID must match the domain the frontend is served from (without port for localhost)
WEBAUTHN_RP_NAME=StockOS
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# For production: WEBAUTHN_RP_ID=yourdomain.com, WEBAUTHN_ORIGIN=https://yourdomain.com

FRONTEND_URL=http://localhost:3000
